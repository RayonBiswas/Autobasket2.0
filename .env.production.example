# Copy to .env.production (gitignored) and fill in every value marked REQUIRED.
# Used by docker-compose.prod.yml: `docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build`

# --- Where the site lives ---
# REQUIRED. A domain with an A record pointing at this server; Caddy fetches HTTPS certificates for it.
# Use ":80" to test the stack on your own machine at http://localhost (no TLS).
SITE_ADDRESS=fridge.example.com
# REQUIRED. Full public URL of the web app (payment links, Telegram messages point here).
WEB_URL=https://fridge.example.com

# --- Safety ---
APP_ENV=production
# REQUIRED. Off in production: with it on, sign-in codes would be shown in API responses.
AUTH_DEV_MODE=0
# REQUIRED. 32+ random characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Only the web app's origin may call the API from a browser.
CORS_ORIGINS=https://fridge.example.com

# --- Database (the api and worker build DATABASE_URL from these) ---
POSTGRES_USER=autobasket
# REQUIRED. Any long random string.
POSTGRES_PASSWORD=
POSTGRES_DB=autobasket

# --- Sign-in emails (REQUIRED in production: this is how people receive their 6-digit code) ---
# Any SMTP provider works (Brevo, Resend, Zoho, Gmail app password...). Port 587 with STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AutoBasket <no-reply@fridge.example.com>

# --- Chat agent + camera (OpenAI-compatible endpoint; OpenRouter works) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini
VISION_MODEL=openai/gpt-4o-mini

# --- Telegram alerts (optional) ---
# After the stack is up: curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://fridge.example.com/api/telegram/webhook&secret_token=<SECRET>"
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- Razorpay payments (optional; test keys work). Webhook URL: https://fridge.example.com/api/payments/razorpay/webhook, event payment_link.paid ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
