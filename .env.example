# Copy to .env (gitignored). Every value has a safe local default; production must set all of them.

# --- Database ---
# Local default is SQLite in backend/. For PostgreSQL run `docker compose up -d db` and use:
# DATABASE_URL=postgresql+psycopg://autobasket:autobasket@localhost:5433/autobasket
# DATABASE_URL=sqlite:///./autobasket.db

# --- Auth ---
# Any long random string; rotating it logs everyone out.
JWT_SECRET=change-me-before-deploying
# 1 = OTP codes are echoed in the API response and logs (never in production)
AUTH_DEV_MODE=1
# JWT_EXPIRES_HOURS=24
# OTP_TTL_MINUTES=10

# --- LLM (chat agent) ---
# Preferred provider: ollama or openai (any OpenAI-compatible endpoint works)
LLM_PROVIDER=ollama
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OLLAMA_MODEL=llama3.1:8b

# --- Alerts and payments (all optional; without them alerts are in-app and payment uses a dev page) ---
# WEB_URL=http://localhost:5173
# TELEGRAM_BOT_TOKEN=123456:ABC...          from @BotFather
# TELEGRAM_BOT_USERNAME=AutoBasketBot
# TELEGRAM_WEBHOOK_SECRET=any-long-random-string
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# VISION_MODEL=openai/gpt-4o-mini            an image-capable model on the OPENAI_BASE_URL endpoint
